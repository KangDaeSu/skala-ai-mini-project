# LangSmith 추적 설정 — 실제 값은 .env에 넣는다 (.env는 git에 커밋하지 않음)
# 이 저장소에서는 ../../../../_통합개념_실습/LANGSMITH/base-langsmith/.env를
# 복사해 써도 된다 (run.sh가 .env가 없으면 자동 복사).
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=capstone-all-total
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LLM_BACKEND=openai 모드(run_openai.sh)에서만 필요 — 실제 OpenAI 계정에 과금되는
# 원격 API 키다. 절대 커밋하지 말고, 본인 계정의 유효한 키를 .env에만 넣을 것.
OPENAI_API_KEY=sk-...
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o

# ── 신뢰성 개선 설정 (모두 선택 — 없으면 기본값) ─────────────────────────
# 단계별 시도당 타임아웃 / 재시도 포함 전체 예산(초): ROUTE·PLAN·ANALYZE·CHAT·WRITE·EMBED
# LLM_TIMEOUT_WRITE=60
# LLM_BUDGET_WRITE=90
# LLM_RETRIES=2
# LLM_RETRY_BASE_DELAY=0.5
# MCP 호출 (prompt·monitoring·runbook)
# LLM_TIMEOUT_MCP=10
# LLM_BUDGET_MCP=20
# 서킷 브레이커: 서비스(llm·mcp·embed)별 연속 실패 N회면 COOLDOWN초 동안 즉시 실패
# CIRCUIT_FAILURES=3
# CIRCUIT_COOLDOWN=30
# 출력 토큰 상한 (JSON 출력: route/plan, 텍스트: chat/write/analyze)
# LLM_MAX_TOKENS_JSON=512
# LLM_MAX_TOKENS_TEXT=1024
# runbook 선택: rag(기본) | keyword(baseline 규칙, Before/After 비교용)
# RUNBOOK_CLASSIFIER=rag
# RAG_QUERY_WEIGHT=0.8
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OPENAI_EMBED_MODEL=text-embedding-3-small
